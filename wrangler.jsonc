{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-08-29",
  "name": "sm-legal",
  "assets": {
    "directory": "./dist",
  },
  "observability": {
    "enabled": false,
  },
  "route": {
    "custom_domain": true,
    "pattern": "legal.supportmail.dev",
  },
  "preview_urls": false,
  "workers_dev": false,
}
